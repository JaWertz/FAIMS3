# FAIMS mobile app build overrides for prod-ish Android builds.
# This file is intentionally minimal to stay close to upstream build logic.

# Backend URL used by the mobile app for login, sync and token exchange.
VITE_CONDUCTOR_URL=https://fe6103-c0005.sna94.uni-tuebingen.de

# App identity used for custom deep-link callback after browser login.
VITE_APP_ID=org.fedarch.faims3
VITE_APP_NAME=Fieldmark
VITE_HEADING_APP_NAME=Fieldmark

# Keep mobile web assets rooted at "/" for Capacitor bundle loading.
VITE_BASE_PATH=/

# Hardened host list if preview is used during testing.
VITE_ALLOWED_HOSTS=fe6103-c0005.sna94.uni-tuebingen.de,localhost,127.0.0.1

# Reduce debug tooling in mobile production-like builds.
VITE_DEBUG_APP=false
VITE_POUCHDB_DEBUG=false
VITE_SHOW_POUCHDB_BROWSER=false
VITE_SHOW_WIPE=false
VITE_SUPPORT_EMAIL=jakob.wertz@uni-tuebingen.de