# --- Public URLs (WICHTIG: keine Trailing /) ---
CONDUCTOR_PUBLIC_URL=https://fe6103-c0005.sna94.uni-tuebingen.de
NEW_CONDUCTOR_URL=https://fe6103-c0005.sna94.uni-tuebingen.de

# Web/App public URLs (für Links/Redirects aus der API)
WEB_APP_PUBLIC_URL=https://fe6103-c0005.sna94.uni-tuebingen.de/app
# optional (falls genutzt):
ANDROID_APP_PUBLIC_URL=org.fedarch.faims3://auth-return
IOS_APP_PUBLIC_URL=

# Redirect whitelist: Origin-only Vergleich (scheme+host+port). Kein Pfad nötig.
REDIRECT_WHITELIST=https://fe6103-c0005.sna94.uni-tuebingen.de,org.fedarch.faims3://auth-return

# CouchDB: intern über Docker DNS, extern NUR via Caddy Pfadproxy
COUCHDB_INTERNAL_URL=http://couchdb:5984
COUCHDB_PUBLIC_URL=https://fe6103-c0005.sna94.uni-tuebingen.de/couchdb

# Ports intern
CONDUCTOR_INTERNAL_PORT=8000
TRUST_PROXY=1

# Cookie secret (stabil setzen!)
FAIMS_COOKIE_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
COUCHDB_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Couch credentials (wie bisher)
COUCHDB_USER=adminJW
COUCHDB_PASSWORD=bdbf10a2-14c2-4a0f-a0a2-3a4782e99ff9

# Email service (required by buildconfig)
EMAIL_SERVICE_TYPE=MOCK
TEST_EMAIL_ADDRESS=test@example.org
